# Copy to .env and set real values. .env is gitignored and must never be committed.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=taskmanager
MYSQL_USER=taskmanager
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# HS256 requires at least 32 bytes; the application refuses to start below that
JWT_SECRET=change-me-to-at-least-32-bytes-of-random-secret
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_DAYS=30
# set to true in production so the refresh cookie is only sent over HTTPS
JWT_REFRESH_COOKIE_SECURE=false

BACKEND_PORT=8080
FRONTEND_PORT=3000
